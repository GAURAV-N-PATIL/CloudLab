# Copy to .env.local and adjust. Variables must start with VITE_ to reach the browser.

# true  = Part A: use the in-browser mock API (no backend needed)
# false = Part B: call the real Spring Boot API
VITE_USE_MOCK=true

# Base path for API calls. Keep "/api" in dev (Vite proxies it to localhost:8080).
VITE_API_BASE_URL=/api
