# Copy to .env.local and adjust. Variables must start with VITE_ to reach the browser.

# Mock API is the default (also on Vercel) - no backend needed.
# Set to false to call the real Spring Boot API instead.
VITE_USE_MOCK=true

# Base path for API calls (only used when VITE_USE_MOCK=false).
# Dev: keep "/api" (Vite proxies it to localhost:8080).
# Production: full backend URL, e.g. https://your-backend.example.com/api
VITE_API_BASE_URL=/api
